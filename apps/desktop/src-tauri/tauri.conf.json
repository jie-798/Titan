{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Titan",
  "version": "0.1.0",
  "identifier": "com.jie798.titan",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Titan",
        "width": 1400,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "digestAlgorithm": "sha256"
    }
  }
}
